# Copy this file to backend/.env for local Python, or .env for Docker Compose.
DATABASE_URL=sqlite:///./data/folio.db
ENVIRONMENT=development
APP_ORIGIN=http://127.0.0.1:8000
ALLOWED_HOSTS=127.0.0.1,localhost
SESSION_HOURS=12
DEMO_MODE=false
# One local API process: refresh quotes and capture snapshots while it runs.
# Leave false when using the separate app.jobs worker; do not enable both.
BACKGROUND_JOBS=false

# Keep the original sheet read-only. Never commit credentials or real data.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SHEET_ID=
GOOGLE_FOLDER_ID=
SYNC_INTERVAL_MINUTES=15

# disabled or finnhub; paid entitlements may be needed for some datasets.
MARKET_PROVIDER=disabled
MARKET_API_KEY=
MARKET_REQUESTS_PER_MINUTE=6
# Free no-key daily history; use market only with a history-enabled vendor plan.
HISTORY_PROVIDER=yahoo
RISK_FREE_RATE=0.04

# Optional OpenAI-compatible chat-completions endpoint; keys stay server-side.
# Example base URL shape: https://your-provider.example/v1 (without /chat/completions)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Docker only: generate a random hex password; do not use this blank default.
POSTGRES_PASSWORD=

# Free spot marks; confirm pure-metal quantity units first.
SPOT_QUOTES_ENABLED=false
METAL_QUANTITY_UNIT=unconfirmed
